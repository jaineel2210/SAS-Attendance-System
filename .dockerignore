logs/
*.log

# Local config
.env
.env.local

# Build artifacts
*.egg-info/
dist/
build/

# Node modules (if any frontend build)
node_modules/

# Documentation markdown (not needed in container)
*.md
!README.md

# Test files
test_*.py
*_test.py

# Database files
*.db
*.sqlite
